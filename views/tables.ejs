<%- include('header.ejs') %>
<%- include('nav.ejs') %>
<%- include('partials/page-header.ejs') %>

<main class="container py-4">
  <% divisions.forEach(function(division){ %>
  <h2 class="data-card-heading"><%= division.league %> &mdash; <%= division.name %> <small class="text-muted">(<%= division.hydeTeams.join(' & ') %>)</small></h2>
  <div class="data-card">
    <table class="text-center mb-0">
        <tr>
            <% division.columns.forEach(function(col){ %><th><%= col %></th><% }) %>
        </tr>
        <% division.rows.forEach(function(row){ %>
        <tr class="<%= row.isHyde ? 'table-highlight' : '' %>">
            <% row.values.forEach(function(value){ %><td><%= value %></td><% }) %>
        </tr>
        <% }) %>
    </table>
  </div>
  <% }) %>
</main>

<%- include('footer.ejs') %>
