<%- include('header.ejs') %>
<%- include('nav.ejs') %>
<%- include('partials/page-header.ejs') %>

<main class="container py-4">
  <% if (typeof seasons !== 'undefined' && seasons.length > 1) { %>
  <ul class="nav nav-pills mb-3">
      <% seasons.forEach(function(s){ %>
      <li class="nav-item">
          <a class="nav-link <%= s.value === season ? 'active' : '' %>" href="/fixtures/<%= team %>/<%= s.value %>"><%= s.label %></a>
      </li>
      <% }) %>
  </ul>
  <% } %>
  <div class="data-card">
    <table class="text-center mb-0">
        <tr>
            <th>Date</th>
            <th>Day</th>
            <th>Opponents</th>
            <th>Home/Away</th>
            <th>Competition</th>
            <th>Result</th>
        </tr>
        <% for (row of result){ %>
        <tr>
            <td><%= row.date %></td>
            <td><%= row.dotw %></td>
            <td><%= row.opposition %></td>
            <td><%= row.homeOrAway %></td>
            <td><%= row.competition %></td>
            <td>
              <%= row.result %>
              <% if (row.outcome) { %>
              <span class="badge-result badge-result--<%= row.outcome %>"><%= row.outcome %></span>
              <% } %>
            </td>
        </tr>
        <% } %>
    </table>
  </div>
</main>

<%- include('footer.ejs') %>
